# Backend configuration. All of it is optional: uncommenting a line below and
# leaving the value alone changes nothing, because the values shown are the
# defaults from backend/app/core/settings.py. The one exception is the runtime
# root, which has no default worth printing and says so where it appears.
#
# The backend reads .env from the directory it is started in, and the README
# starts it in backend/, so:
#
#     cp .env.example backend/.env
#
# An empty value is not the same as an absent one. The numbers and the booleans
# here reject an empty string and the server will not start; the API key at the
# bottom is a string, so empty is fine there and means "no key".

# The local planner talks to Ollama over HTTP. No model ships with this repo.
#AI_CAD_OLLAMA_MODEL=llama3.1:8b
#AI_CAD_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Generous on purpose. A 7B model on a CPU takes its time over a build plan, and
# cutting it off early only sends the request to the fallback planner anyway.
#AI_CAD_OLLAMA_TIMEOUT_SECONDS=180

# Ask Ollama first. False gets you the rule-based planner, which is
# deterministic and is what the test suite runs against.
#AI_CAD_PREFER_LOCAL_MODEL_PLANNER=true

# Designs, the build cache and the quota ledger. This one has no literal default
# worth printing: it resolves to backend/runtime from the app package rather
# than the working directory, so it lands in the same place wherever the server
# was started. Point it somewhere else with an absolute path.
#AI_CAD_RUNTIME_ROOT=/absolute/path/to/runtime

# How long one executor subprocess gets before it is killed. A long plan with a
# cold cache can want more than this; the failure report names the variable.
#AI_CAD_DEFAULT_EXECUTOR_TIMEOUT_SECONDS=30

# The build always runs as a local subprocess. This only decides whether the
# gate to hosted models can open at all, by way of runtime/executor-health.json.
#AI_CAD_EXECUTOR_MODE=local

# One more origin on the CORS allow-list, which already carries the Vite dev
# server on 5173 and the Tauri shell. Set this if you serve the UI elsewhere.
#AI_CAD_FRONTEND_ORIGIN=http://localhost:5173

# The gate on hosted models. Off means the gateway never reaches for Gemini no
# matter what key is set below, which is why the key alone is not enough.
#AI_CAD_ALLOW_HOSTED_MODELS=false

# Hosted models also need the gate above open and a healthy containerized
# executor, so empty is the normal case. Never commit a real key.
AI_CAD_GEMINI_API_KEY=
